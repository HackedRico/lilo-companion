# Optional. Everything here can be set in the preferences window instead, and
# anything left blank falls through to these.

# Where the model is: a hosted service, a gateway, or a server on this machine.
# How it speaks is worked out from the address, so there is no vendor setting.
# For local Ollama: LLM_BASE_URL=http://localhost:11434 (no API key needed).
LLM_BASE_URL=
LLM_API_KEY=

# The quick one reads the lecture and answers questions. The careful one
# coaches on LeetCode and inspects code (e.g. qwen2.5-coder:7b, llama3.2).
MODEL_FAST=
MODEL_STRONG=
