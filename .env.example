# Optional. Everything here can be set in the preferences window instead, and
# anything left blank falls through to these.

# Anywhere that speaks the OpenAI chat API: Featherless, Ollama, LM Studio,
# OpenAI, OpenRouter, Groq, your own vLLM. There is no provider setting.
LLM_BASE_URL=
LLM_API_KEY=

# The quick one reads the lecture and plays the coworker. The careful one writes
# the work and reviews the answer.
MODEL_FAST=
MODEL_STRONG=

# Only needed to listen to a real room. A saved lecture and pasted notes do not.
DEEPGRAM_API_KEY=
